{
  "name": "wellmix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "appwrite": "appwrite",
    "appwrite:push": "npm run appwrite:config && node scripts/appwrite-push.ts",
    "appwrite:generate": "appwrite generate",
    "appwrite:connect": "node scripts/appwrite-connect.mjs",
    "appwrite:config": "node scripts/appwrite-config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "appwrite:reset": "node scripts/appwrite-reset.ts",
    "appwrite:rename-brand": "node scripts/appwrite-rename-brand.ts"
  },
  "dependencies": {
    "appwrite": "^27.0.0",
    "next": "16.3.6",
    "node-appwrite": "^29.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "appwrite-cli": "^27.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
