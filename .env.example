# ---------------------------------------------------------------------------
# Willmix — variáveis de ambiente
# Copie para .env.local (dev) e cadastre as mesmas chaves na Vercel.
# NUNCA commite .env.local. Valores NEXT_PUBLIC_* vão para o browser.
# ---------------------------------------------------------------------------

# Appwrite (console > Settings > Overview)
# Endpoint depende da região do projeto, ex.: https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Chave de API do servidor (console > Settings > API keys). Nunca vai ao browser.
# Escopos mínimos para começar: sessions.write, users.read, users.write,
# teams.read, teams.write, databases.read, databases.write, files.read, files.write
APPWRITE_API_KEY=

# IDs de recursos criados no console ou via CLI (docs/APPWRITE.md)
APPWRITE_DATABASE_ID=willmix
APPWRITE_BUCKET_ID=arquivos
