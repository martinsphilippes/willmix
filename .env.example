# ---------------------------------------------------------------------------
# Wellmix — variáveis de ambiente
# Copie para .env.local (dev) e cadastre as mesmas chaves na Vercel.
# NUNCA commite .env.local. Valores NEXT_PUBLIC_* vão para o browser.
# ---------------------------------------------------------------------------

# Modo de dados: memory (desenvolvimento, dados em .data/) ou appwrite (produção).
# Sem esta variável: appwrite quando as chaves abaixo existem, senão memory.
DATA_MODE=memory

# Appwrite (console > Settings > Overview)
# Endpoint depende da região do projeto, ex.: https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Chave de API do servidor (console > Settings > API keys). Nunca vai ao browser.
# Escopos mínimos: sessions.write, users.read, users.write, teams.read, teams.write,
# databases.read, databases.write, files.read, files.write
APPWRITE_API_KEY=

# Segredo que assina o cookie de sessão no modo memória (obrigatório em produção).
SESSION_SECRET=

# Protege /api/jobs/reminders (cron da Vercel) e /api/admin/seed em produção.
CRON_SECRET=

# IA (opcional): chave da API da Anthropic para cadastro por foto e textos de marketing.
# Sem a chave, o sistema fica em modo manual (nenhuma sugestão inventada); aiMode=MOCK
# nas configurações devolve um exemplo rotulado para demonstração.
ANTHROPIC_API_KEY=

# Sankhya Om (ERP) pela API Gateway oficial, OAuth 2.0 client credentials (docs/SANKHYA.md).
# Client ID e Client Secret: Área do Desenvolvedor da Sankhya (aplicação criada lá).
# X-Token: no Sankhya Om, tela "Configurações Gateway" (token da integração da empresa).
# Sem as três, Configurações → Sankhya diz o que falta e os pedidos seguem com número manual.
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=
SANKHYA_X_TOKEN=
# Opcional: https://api.sankhya.com.br (padrão) ou https://api.sandbox.sankhya.com.br
SANKHYA_BASE_URL=
