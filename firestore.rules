rules_version = '2';

// Política padrão: negar tudo. Cada coleção libera explicitamente o que precisa.
// Escritas de negócio passam pelo servidor (Admin SDK) para centralizar regras e auditoria.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Perfil do próprio usuário: leitura livre para ele, escrita só pelo servidor.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
